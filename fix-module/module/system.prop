# ColorOS' render-intent table is from the source phone.  The tablet's
# Qualcomm/Oplus display manager uses 0 for its standard (sRGB) path and
# 256/259 for its native-gamut path (the native color-manager translator
# explicitly maps both 256 and 259 to hardware mode 4).  Keep the ColorOS
# labels, but translate their backend values before ColorDisplayService is
# initialized:
#   生动   -> native gamut
#   自然   -> standard/sRGB
#   专业鲜艳 -> native gamut (the framework's 259 is already native)
ro.oplus.display.colormode.vivid.renderintent=256
ro.oplus.display.colormode.soft.renderintent=0

# 杜比音效（原厂 DAX3 DMS HAL 链路）：特性由 post-fs-data 的
# com.oplus.oplus-feature.xml 覆盖开启，这里补齐均衡器/模式支持属性。
ro.oplus.audio.dolby.equalizer_support=true
ro.oplus.audio.dolby.movieToMusic_support=true

# HMBIRD 是一加基于 sched_ext/scx 的调度框架，需要 hmbird_sched 系列内核模块。
# 那批模块不在我们移植过来的 23 个 oplus ko 里（已加载的 oplus_cpu_sched_* 是
# 另一套 restricted vendor hook，两者无关），实机确认 /sys/kernel/hmbird*、
# /proc/hmbird*、/sys/kernel/sched_ext* 全部不存在。
# 因此在 property-init 阶段就关掉云控管理器，否则它会反复重试并回落到杀缓存。
# 这是与 oplus_bsp_horae_shell_temp、oplus_bsp_healthinfo 同类的**永久保留项**，
# 不属于"内核节点补齐后可以撤销"的那一批。
sys.oplus.hmbird.manager.enable=0

# persist.sys.oplus.nandswap 一律不由本模块写。
# 它不是开关，而是 Settings.Secure.customize_ram_swap_state 的派生镜像；
# 更要紧的是原厂 init.oplus.nandswap.sh 把 persist.sys.oplus.nandswap.swapsize
# 当作**输入**（disksize = swapsize + zram_increase），我们回写等于每次开机
# 让它自我膨胀。现在 hybridswap 与内存扩展整条链路都交还给原厂脚本。
