# ColorOS' render-intent table is from the source phone.  The tablet's
# Qualcomm/Oplus display manager uses 0 for its standard (sRGB) path and
# 256/259 for its native-gamut path (the native color-manager translator
# explicitly maps both 256 and 259 to hardware mode 4).  Keep the ColorOS
# labels, but translate their backend values before ColorDisplayService is
# initialized:
#   生动   -> native gamut
#   自然   -> standard/sRGB
#   专业鲜艳 -> native gamut (the framework's 259 is already native)
ro.oplus.display.colormode.vivid.renderintent=256
ro.oplus.display.colormode.soft.renderintent=0

# 杜比音效（原厂 DAX3 DMS HAL 链路）：特性由 post-fs-data 的
# com.oplus.oplus-feature.xml 覆盖开启，这里补齐均衡器/模式支持属性。
ro.oplus.audio.dolby.equalizer_support=true
ro.oplus.audio.dolby.movieToMusic_support=true

# HMBIRD 是一加基于 sched_ext/scx 的调度框架，需要 hmbird_sched 系列内核模块。
# 那批模块不在我们移植过来的 23 个 oplus ko 里（已加载的 oplus_cpu_sched_* 是
# 另一套 restricted vendor hook，两者无关），实机确认 /sys/kernel/hmbird*、
# /proc/hmbird*、/sys/kernel/sched_ext* 全部不存在。
# 因此在 property-init 阶段就关掉云控管理器，否则它会反复重试并回落到杀缓存。
# 这是与 oplus_bsp_horae_shell_temp、oplus_bsp_healthinfo 同类的**永久保留项**，
# 不属于"内核节点补齐后可以撤销"的那一批。
sys.oplus.hmbird.manager.enable=0

# persist.sys.oplus.nandswap 一律不由本模块写。
# 它不是开关，而是 Settings.Secure.customize_ram_swap_state 的派生镜像；
# 更要紧的是原厂 init.oplus.nandswap.sh 把 persist.sys.oplus.nandswap.swapsize
# 当作**输入**（disksize = swapsize + zram_increase），我们回写等于每次开机
# 让它自我膨胀。现在 hybridswap 与内存扩展整条链路都交还给原厂脚本。

# ---------------------------------------------------------------------------
# 压掉基带残留造成的日志刷屏（v2.10.0）
#
# 摘除虚拟基带栈之后，7 个调制解调器相关进程还在以精确 1 Hz 死等 7 个
# vintf / init.rc 里根本没有声明的 HAL（IDpmService、IQHDC、IIWlan/slot1、
# ITxPwrService、ISubsysRadio/slot1、ISubsys、IRadio/vircommslot1）。
# 每轮打两行：
#   W ServiceManagerCppClient: Waited one second for <iface> (is service started?...)
#   W libc: Unable to set property "ctl.interface_start" ... PROP_ERROR_HANDLE_CONTROL_MESSAGE
# 实测安静期 25 秒 1111 行日志里有 500 行（45%）是这个循环，logd 因此常驻 2.3% CPU，
# 256 KiB 的 main 环几分钟就被冲干净，真出问题时根本抓不到现场。
#
# 这里只堵 ServiceManagerCppClient 一个 tag。实机验证过 log.tag=S 对 W 级别有效
# （最近 400 行内 77 条 → 0 条），不是只对 V/D/I 生效。
# 故意不堵 libc —— 那个 tag 承载着大量真正有用的告警，堵掉得不偿失。
#
# 注意这只是止血：进程仍在 1 Hz 空转（阻塞等待，几乎不吃 CPU）。
# 真正的清理是让这几个孤儿客户端别起来，但电话栈很脆
# （历史教训：SIM 槽数置 0 会崩溃死循环），留待单独验证。
# 撤销：删掉下面一行。
# ---------------------------------------------------------------------------
persist.log.tag.ServiceManagerCppClient=S

# ============================================================================
# 关掉 AOSP 的 per-app memcg，把内存分组交还给原厂那套
#
# 与原厂 PKX110（SM8750 / ColorOS V16.1.0）逐项对比后发现的**唯一**差异项：
#   原厂：ro.config.per_app_memcg 未设置
#   本机：ro.config.per_app_memcg = true
#
# 这个开关一开，AOSP 的 ActivityManagerService 会按 uid/pid 建
# /dev/memcg/apps/uid_<uid>/pid_<pid>，把 OPlus 自己那套分组挤掉。两边的实际
# 形态差得很远：
#   原厂：64 个组，按**包名**分 —— active/ inactive/ systemserver/
#         com.tencent.mm/ com.android.chrome/ …，
#         active 里装着桌面 + SystemUI + 相机 + 负一屏，inactive 里 68 个后台进程
#   本机：164 个组，按 **uid** 分 —— uid_1000/ uid_10091/ …，
#         而原厂建的 active/ launcher/ systemserver 三个组**一个进程都没有**
#
# 也就是说 OPlus 按应用状态在 active/inactive 之间搬进搬出的那套内存管理，在
# 本机从来没跑起来过，退化成了 AOSP 的按 uid 分组。
#
# 内核这边是支持的：两台机器的 /dev/memcg 节点集合逐项比对完全一致，
# memory.app_uid（原厂建包名组的入口）在本机也在，不是内核缺功能。
#
# 撤销：删掉这一行，重启即回到 AOSP 的 per-app memcg。
# ============================================================================
ro.config.per_app_memcg=false
