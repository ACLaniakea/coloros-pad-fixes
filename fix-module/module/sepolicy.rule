allow hal_gameopt_oplus_aidl system_file file { read open getattr map execute };
allow oplus_phonemanager_app proc_stat file { read open getattr };
allow oplus_phonemanager_app vendor_sysfs_kgsl file { read open getattr };
allow platform_app vendor_qdsp_device chr_file { open read write ioctl getattr };
allow platform_app vendor_xdsp_device chr_file { open read write ioctl getattr };
allow platform_app adsprpcd_file file { open read getattr map };
allow platform_app vendor_file dir { open read getattr search watch };
allow platform_app adsprpcd_file dir { open read getattr search watch };
allow hal_audio_default system_file file { read open getattr map };

# 源机 ROM 的 nandswap 开机自检（SELinux 域 u:r:nandswap:s0）会跑 mount 与 df
# 遍历全部挂载点。本机多了两类源策略从未预料到的挂载 —— 本模块的 bind mount
# 与 KernelSU 的 loop 挂载 —— 于是自检撞上一连串 avc denied：
#
#   denied { search }  /data/adb                            adb_data_file       dir
#   denied { getattr } /vendor/bin/init.qcom.post_boot.sh   vendor_file         file
#   denied { getattr } /vendor/bin/init.kernel.post_boot.sh vendor_qti_init_shell_exec file
#   denied { getattr } /mnt/hm_xvVyAjSGCS                   unlabeled           dir
#
# 这些拒绝是我们自己引入挂载造成的，补上属于修复我们弄坏的部分，四条都只授予
# 只读的 search/getattr。实测加入后该域的拒绝数由一大串降为 0。
#
# 注：早先这里写着"内存扩展开关修不好是因为本机没有 /proc/nandswap 等内核接口"，
# 那已经是过时结论。oplus_mm_hybridswap_zram 现已开机自动加载，
# /product/bin/init.oplus.nandswap.sh 靠 /sys/block/zram0/hybridswap_core_enable
# 自行探测并接管全套启用逻辑，mem→zram→UFS 三层实测全通。
# 原文提到的 restore_ram_expansion_intent 函数也早已从 service.sh 删除。
# 下面四条规则与内核缺口无关，是纯粹的挂载副作用修复，保留。
# 后两条对应 post_boot 脚本的 bind——该 bind 已撤销，但 KernelSU 自身的
# 挂载仍可能让 nandswap 自检 getattr 到这两个路径，故一并留着，纯只读无风险。
allow nandswap adb_data_file dir search;
allow nandswap vendor_file file getattr;
allow nandswap vendor_qti_init_shell_exec file getattr;
allow nandswap unlabeled dir getattr;

# ---------------------------------------------------------------------------
# 让 init 能从 nosuid 文件系统上的可执行文件切进 nandswap 域
#
# 2026-08-29 v2.8.0 起，post-fs-data 会把改过的
# /product/bin/init.oplus.nandswap.sh bind 上去（补出 ≤9G 档、把原厂自己算出
# 却漏发的 zram2ufs_ratio 真正下发）。产物落在 /data 上时服务一次都没起来：
#
#   avc: denied { execute_no_trans } path=".../init.oplus.nandswap.sh" dev="sda14"
#   avc: denied { nosuid_transition } scontext=u:r:init:s0 tcontext=u:r:nandswap:s0 tclass=process2
#   op=security_bounded_transition seresult=denied oldcontext=u:r:init:s0 newcontext=u:r:nandswap:s0
#
# sda14 就是 /data，挂载选项带 nosuid。内核在 nosuid 文件系统上不做常规域切换，
# 只接受"被 bound 的域"或显式的 process2:nosuid_transition 许可；两者都没有，
# 于是 init 退回 execute_no_trans（在原域里直接执行），那条也没许可 ⇒ 服务不执行,
# 整次开机 hybridswap 全程 disable。
#
# 这一条只放开 init → nandswap 这一对，且只放开"允许在 nosuid 挂载上切域"这一件事，
# 不新增任何文件/网络访问；目标域 nandswap 的权限集完全没变。
# 有了它，产物放 /data 或 tmpfs 都能跑（post-fs-data 里仍优先用 tmpfs，
# 那条路径本身就不触发这个检查，本规则是兜底）。
# 撤销：删掉本行即可，nandswap 会退回执行原厂脚本。
# ---------------------------------------------------------------------------
allow init nandswap process2 nosuid_transition;

# The camera provider executable is bind-mounted from the module's /data
# payload.  Preserve init's normal transition into hal_camera_default even
# though /data is mounted nosuid; all permissions of the target domain remain
# unchanged.
allow init hal_camera_default process2 nosuid_transition;

# 前摄指示灯由 system_server 内 CameraServiceProxy 的事件桥接一次性写入。
# 节点标签与原厂显示/图形 sysfs 相同；只增加 brightness 文件的最小访问集。
allow system_server vendor_sysfs_graphics file { open write getattr };

# 集成的 CryptoEng 分流代理仍在原厂 hal_cryptoeng_oplus 域中运行；仅允许
# 从模块的 nosuid 文件系统转入该既有域及其原厂数据访问，不扩大其它域权限。
allow init hal_cryptoeng_oplus:process2 nosuid_transition;
allow init hal_cryptoeng_oplus:process transition;
allow init hal_cryptoeng_oplus_exec:file { execute read open map getattr entrypoint };
allow hal_cryptoeng_oplus hal_cryptoeng_oplus_exec:file { execute execute_no_trans read open map getattr };
allow hal_cryptoeng_oplus radio_prop:file read;
allow hal_cryptoeng_oplus vendor_radio_prop:file read;
allow hal_cryptoeng_oplus vendor_prop:file read;
allow hal_cryptoeng_oplus property_type:file read;
allow hal_cryptoeng_oplus vendor_persist_data_file:dir { read getattr open search };
allow hal_cryptoeng_oplus vendor_persist_data_file:file { read write open getattr create unlink rename setattr append };
allow hal_cryptoeng_oplus cryptoeng_data_file:dir { read write getattr open search create add_name remove_name };
allow hal_cryptoeng_oplus cryptoeng_data_file:file { read write open getattr create unlink rename setattr append };

# ---------------------------------------------------------------------------
# 放行 oplus binder UX 通路（2026-08-29 v2.10.0）
#
# dmesg 里 33 条 avc denied 中有 40 条命中同一个目标（去重后 5 类，累计 40 次）：
#
#   avc: denied { ioctl } C="android.anim"    path="/proc/oplus_binder/ux_flag"
#        ioctlcmd=0x6900 scontext=u:r:system_server:s0
#        tcontext=u:object_r:oplus_binder_proc:s0 tclass=file permissive=0
#   同样的还有 android.display / android.ui / binder:2473_B / binder:2473_1B
#
# 被拦的全是 system_server 的 UI 关键线程。它们在往 ux_flag 下发
# "这笔 binder 事务属于 UX 关键路径" 的标记，好让 oplus_binder 把服务端线程
# 一起提到 UX 优先级（binder 优先级继承）。SELinux 挡掉 ioctl 之后，
# 这个继承整条都不生效 —— 前台应用发起的 binder 调用在 system_server 侧
# 被当普通任务调度，正好对得上 SystemUI/桌面 9.8% 的掉帧率里
# SlowDraw > SlowUI 的形态。
#
# 节点本身是 ROM 自带的（oplus_binder ko 创建，标签 oplus_binder_proc，
# 权限 0666），源策略里本该有对应的 allow，是移植过程中丢掉的那一条。
# 这属于"把原厂机制修回去"，不是我们自造的新行为。
#
# 两条规则的关系：
#   allow      —— 补基础 ioctl 权限（这是 avc 直接报的那一项）
#   allowxperm —— 全范围放开，避免万一策略里已存在窄 xperm 规则时被二次拦截；
#                 给全范围等价于不加限制，不会比现在更严。
#
# 验证方法：重启后 `dmesg | grep -c 'oplus_binder/ux_flag'` 应为 0。
# 撤销：删掉下面 4 行。
# ---------------------------------------------------------------------------
allow system_server oplus_binder_proc file { open read write ioctl getattr };
allowxperm system_server oplus_binder_proc file ioctl { 0x0000-0xffff };

# 同一条 UX 链路的应用侧入口：应用把自己的关键线程 tid 写进 ux_task_app，
# sched_assist 据此把它们标成 UX 任务。dmesg 里有
#   avc: denied { read write } C="oloros.weather2" name="ux_task_app"
#        scontext=u:r:untrusted_app:s0:c53,c257,c512,c768
# 节点权限同样是 0666（proc_create("ux_task_app", 0666, ...)，见
# sched_assist/sa_sysfs.c:1243），原厂就是让普通应用直接写的。
allow untrusted_app oplus_ux_task_app_proc file { open read write ioctl getattr };
allow platform_app oplus_ux_task_app_proc file { open read write ioctl getattr };
allow system_app oplus_ux_task_app_proc file { open read write ioctl getattr };
allowxperm untrusted_app oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };
allowxperm platform_app oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };
allowxperm system_app oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };

# ===========================================================================
# 2026-09-11：补回移植丢失的调度 / 帧提升 SELinux 放行
#
# 对照手机（同 ColorOS 16，日志缓冲覆盖 05-24 ~ 09-11 共 3.5 个月）：
#   手机 avc denied 合计 10 条，且全是良性的 zygote unix_stream_socket getopt。
#   平板 20 分钟内 323 条，其中 331 次判定里 permissive=0 占 331-2，全部真拦。
# 下面只补"平板有、手机没有"且确实打断功能的那几类，纯噪声的不补。
#
# --- 1. sched_assist 的 UX 标记入口 ---------------------------------------
# /proc/oplus_scheduler/sched_assist/ 下只有两个文件被 ROM 策略单独打了标签：
#     im_flag_app   -> oplus_imflag_app_proc
#     ux_task_app   -> oplus_ux_task_app_proc   （本文件上方已放行）
# 其余文件全部继承目录标签 oplus_scheduler_sched_assist_proc：
#     im_flag  ux_task  lb_enable  sched_assist_enabled ...
# 实测 DAC 是 0666（im_flag / ux_task / lb_enable），即内核侧就是让应用直接写的，
# 只有 sched_assist_enabled 是 0664（仍然只有 root 能写，本规则不改变这点）。
#
# 被拦的实例（各域 comm 见注释）：
#   22 次 untrusted_app  file {read write} name=im_flag,ux_task
#                        << flar2.devcheck / com.coloros.calendar 等
#    3 次 cameraserver   dir  {search}     name=sched_assist  << CDU-1-FrameProc
#    3 次 oplus_backuprestore_app dir {search}                << com.heytap.cloud
# 应用写不进 im_flag/ux_task ⇒ 它们的关键线程不会被标成 UX 任务 ⇒
# sched_assist 的 UX 优先级与迁移优化对这些应用整条失效。
allow untrusted_app oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow untrusted_app oplus_scheduler_sched_assist_proc file { open read write getattr };
allow platform_app oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow platform_app oplus_scheduler_sched_assist_proc file { open read write getattr };
allow system_app oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow system_app oplus_scheduler_sched_assist_proc file { open read write getattr };
allow priv_app oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow priv_app oplus_scheduler_sched_assist_proc file { open read write getattr };
allow cameraserver oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow cameraserver oplus_scheduler_sched_assist_proc file { open read write getattr };

# --- 2. frame_boost 的 UX 线程标记入口 -------------------------------------
# /proc/oplus_frame_boost/ 由本项目 oplus-bsp-module 里的 ua_cpu_ioctl 创建
# （见 oplus-bsp-module/post-fs-data.sh 的模块清单注释）。节点建出来了、标签也
# 对，但 ROM 策略里没有对应的 allow —— 属于"我们把节点装了回来，规则没跟上"。
#
#    9 次 system_app  file {read write} name=sys_ctrl  << .oplus.onetrace 等
#   另有 cameraserver 对 ctrl / sys_ctrl 的拒绝。
# system_server/system_app 靠 sys_ctrl 下发 UX 线程标记，被拦等于帧提升半残。
#
# 注：sys_ctrl 的 DAC 是 0770 system:system，所以即使放行 SELinux，
# cameraserver（非 system uid）仍会被 DAC 挡住 —— 那条纯粹是消除噪声，
# 真正起作用的是 system_app / system_server 两条。ctrl 是 0777，不受此限。
allow system_app proc_frame_boost_sys_ctrl file { open read write getattr };
allow system_server proc_frame_boost_sys_ctrl file { open read write getattr };
allow cameraserver proc_frame_boost_sys_ctrl file { open read write getattr };
allow cameraserver proc_frame_boost_ctrl file { open read write getattr };

# --- 3. Athena 内存优化的两个写入口 ---------------------------------------
#   13 次 system_server zygote_tmpfs    file     {write}  << comm=athena_hybridsw
#    2 次 system_server vndbinder_device chr_file {write} << comm=athena_hybridsw
# athena_hybridsw 是 com.oplus.athena 在 system_server 侧的线程，负责把应用
# 内存交给 hybridswap。两条写入被拦 ⇒ 这条内存回收通路在平板上是断的。
allow system_server zygote_tmpfs file { write open getattr };
allow system_server vndbinder_device chr_file { write open getattr ioctl };

# --- 4. 音频实时线程提权 ---------------------------------------------------
#    5 次 audioserver -> untrusted_app process {getsched} << comm=AudioRtBoostThr
# audioserver 读不到应用音频线程的调度参数 ⇒ 无法把它提到实时优先级。
allow audioserver untrusted_app process getsched;

# --- 5. ADSP 远程调用的目录遍历 -------------------------------------------
#    9 次 priv_app adsprpcd_file dir {search}   << comm=AI-unit[1]
#    4 次 priv_app adsprpcd_file dir {getattr}
# 本文件第 8 行已为 platform_app 放行同一目录，priv_app 是漏掉的那半。
allow priv_app adsprpcd_file dir { open read getattr search };
allow priv_app adsprpcd_file file { open read getattr map };

# --- 6. 2026-09-11 重启复核后补齐的系统服务侧域 ---------------------------
# 上面第 1、2 组是按当时日志里出现过的域写的，只覆盖到应用侧。重启一次之后
# 开机早期又冒出一批系统服务的同类拒绝（各 1~3 次，全部 permissive=0）：
#
#   surfaceflinger           -> oplus_scheduler_sched_assist_proc [dir]  {search}
#   bootanim                 -> oplus_scheduler_sched_assist_proc [dir]  {search}
#   radio (m.android.phone)  -> oplus_scheduler_sched_assist_proc [dir]  {search}
#   permissioncontroller_app -> oplus_scheduler_sched_assist_proc [dir]  {search}
#   audioserver / bootanim / mediaserver / radio / permissioncontroller_app
#                            -> proc_frame_boost_ctrl      [file] {read write}
#   audioserver / bootanim   -> proc_frame_boost_sys_ctrl  [file] {read write}
#   hal_gameopt_oplus_aidl   -> proc_frame_boost_sys_ctrl  [file] {ioctl}
#
# surfaceflinger 那条最要紧：合成器被拦在 sched_assist 目录门口，等于它自己的
# 关键线程没法登记成 UX 任务。这与本轮新增的 oplus_lb_bridge 是同一条链——
# 负载均衡接通了，但线程没被标成 UX，均衡器也挑不出它们来迁移。
#
# 注：sys_ctrl 的 DAC 是 0770 system:system，audioserver / bootanim 不是
# system uid，放行 SELinux 后仍会被 DAC 挡住，那两条只为消除日志噪声；
# ctrl 是 0777，对应的几条是真的会生效。
allow surfaceflinger oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow surfaceflinger oplus_scheduler_sched_assist_proc file { open read write getattr };
allow bootanim oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow radio oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow radio oplus_scheduler_sched_assist_proc file { open read write getattr };
allow permissioncontroller_app oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow permissioncontroller_app oplus_scheduler_sched_assist_proc file { open read write getattr };

allow surfaceflinger proc_frame_boost_ctrl file { open read write getattr };
allow surfaceflinger proc_frame_boost_sys_ctrl file { open read write getattr };
allow audioserver proc_frame_boost_ctrl file { open read write getattr };
allow audioserver proc_frame_boost_sys_ctrl file { open read write getattr };
allow bootanim proc_frame_boost_ctrl file { open read write getattr };
allow bootanim proc_frame_boost_sys_ctrl file { open read write getattr };
allow mediaserver proc_frame_boost_ctrl file { open read write getattr };
allow radio proc_frame_boost_ctrl file { open read write getattr };
allow permissioncontroller_app proc_frame_boost_ctrl file { open read write getattr };
allow hal_gameopt_oplus_aidl proc_frame_boost_sys_ctrl file { open read write getattr ioctl };
allowxperm hal_gameopt_oplus_aidl proc_frame_boost_sys_ctrl file ioctl { 0x0000-0xffff };

# --- 7. 2026-09-11 第二次重启复核后的收尾 ---------------------------------
# 上一组补完之后重启，拒绝从 20 条降到 12 条，剩下的全是同两类缺口：
#
# (a) ux_task_app 的系统服务侧
#     本文件第 123~128 行（更早加的）只放行了 untrusted_app / platform_app /
#     system_app 三个应用域。实测下列系统服务同样在写这个节点：
#         surfaceflinger  bootanim  audioserver  mediaserver
#         radio(m.android.phone)  permissioncontroller_app
#     surfaceflinger 那条是关键——合成器把自己的关键线程 tid 写进 ux_task_app，
#     sched_assist 据此标 UX；被拦就等于合成线程从未进入 UX 集合，
#     新装的 oplus_lb_bridge 再怎么均衡也挑不到它们。
#
# (b) frame_boost ctrl 的 ioctl
#     第 6 组只给了 read/write/open/getattr，漏了 ioctl，也没配 allowxperm。
#     实测调用方用的是 ioctlcmd=0xde02（见 radio 与 permissioncontroller_app）。
#     节点 DAC 是 0777，原厂就是让各域直接 ioctl 的。
allow surfaceflinger oplus_ux_task_app_proc file { open read write getattr ioctl };
allow bootanim oplus_ux_task_app_proc file { open read write getattr ioctl };
allow audioserver oplus_ux_task_app_proc file { open read write getattr ioctl };
allow mediaserver oplus_ux_task_app_proc file { open read write getattr ioctl };
allow radio oplus_ux_task_app_proc file { open read write getattr ioctl };
allow permissioncontroller_app oplus_ux_task_app_proc file { open read write getattr ioctl };
allowxperm surfaceflinger oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };
allowxperm bootanim oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };
allowxperm audioserver oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };
allowxperm mediaserver oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };
allowxperm radio oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };
allowxperm permissioncontroller_app oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };

allow surfaceflinger proc_frame_boost_ctrl file ioctl;
allow bootanim proc_frame_boost_ctrl file ioctl;
allow audioserver proc_frame_boost_ctrl file ioctl;
allow mediaserver proc_frame_boost_ctrl file ioctl;
allow radio proc_frame_boost_ctrl file ioctl;
allow permissioncontroller_app proc_frame_boost_ctrl file ioctl;
allow cameraserver proc_frame_boost_ctrl file ioctl;
allowxperm surfaceflinger proc_frame_boost_ctrl file ioctl { 0x0000-0xffff };
allowxperm bootanim proc_frame_boost_ctrl file ioctl { 0x0000-0xffff };
allowxperm audioserver proc_frame_boost_ctrl file ioctl { 0x0000-0xffff };
allowxperm mediaserver proc_frame_boost_ctrl file ioctl { 0x0000-0xffff };
allowxperm radio proc_frame_boost_ctrl file ioctl { 0x0000-0xffff };
allowxperm permissioncontroller_app proc_frame_boost_ctrl file ioctl { 0x0000-0xffff };
allowxperm cameraserver proc_frame_boost_ctrl file ioctl { 0x0000-0xffff };
allow bootanim oplus_scheduler_sched_assist_proc file { open read write getattr };
allow audioserver oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow audioserver oplus_scheduler_sched_assist_proc file { open read write getattr };
allow mediaserver oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow mediaserver oplus_scheduler_sched_assist_proc file { open read write getattr };

# --- 8. 收尾：用 untrusted_app_all 属性终止逐域追加 -------------------------
# 第三次重启后只剩两类，暴露了前面按域逐条写的根本问题：
#
#   untrusted_app_30 (com.omarea.vtools, comm=hwuiTask0) -> ux_task / im_flag
#   mediaprovider    (com.android.photopicker)           -> sched_assist [dir]
#
# untrusted_app_30 是**独立的 SELinux 类型**，不是 untrusted_app 的实例——
# AOSP 按应用的 targetSdk 分出 untrusted_app_25/27/29/30/32 等一串类型，
# 前面那条 allow untrusted_app 一个都覆盖不到。继续逐个补是打地鼠，
# 改用 AOSP 自带的 untrusted_app_all 属性，它按定义涵盖全部这些类型。
#
# 放行范围与原厂意图一致：这两个节点的 DAC 都是 0666
# （proc_create("ux_task", 0666, ...) / im_flag 同），OPlus 本来就让普通应用
# 直接写；对照手机上同类访问一次拒绝都没有。
allow untrusted_app_all oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow untrusted_app_all oplus_scheduler_sched_assist_proc file { open read write getattr };
allow untrusted_app_all oplus_ux_task_app_proc file { open read write getattr ioctl };
allowxperm untrusted_app_all oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };
allow mediaprovider oplus_scheduler_sched_assist_proc dir { search open read getattr };
allow mediaprovider oplus_scheduler_sched_assist_proc file { open read write getattr };
allow mediaprovider oplus_ux_task_app_proc file { open read write getattr ioctl };
allowxperm mediaprovider oplus_ux_task_app_proc file ioctl { 0x0000-0xffff };
