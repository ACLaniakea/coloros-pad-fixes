allow hal_gameopt_oplus_aidl system_file file { read open getattr map execute };
allow oplus_phonemanager_app proc_stat file { read open getattr };
allow oplus_phonemanager_app vendor_sysfs_kgsl file { read open getattr };
allow platform_app vendor_qdsp_device chr_file { open read write ioctl getattr };
allow platform_app vendor_xdsp_device chr_file { open read write ioctl getattr };
allow platform_app adsprpcd_file file { open read getattr map };
allow platform_app vendor_file dir { open read getattr search watch };
allow platform_app adsprpcd_file dir { open read getattr search watch };
allow hal_audio_default system_file file { read open getattr map };

# 源机 ROM 的 nandswap 开机自检（SELinux 域 u:r:nandswap:s0）会跑 mount 与 df
# 遍历全部挂载点。本机多了两类源策略从未预料到的挂载 —— 本模块的 bind mount
# 与 KernelSU 的 loop 挂载 —— 于是自检撞上一连串 avc denied：
#
#   denied { search }  /data/adb                            adb_data_file       dir
#   denied { getattr } /vendor/bin/init.qcom.post_boot.sh   vendor_file         file
#   denied { getattr } /vendor/bin/init.kernel.post_boot.sh vendor_qti_init_shell_exec file
#   denied { getattr } /mnt/hm_xvVyAjSGCS                   unlabeled           dir
#
# 这些拒绝是我们自己引入挂载造成的，补上属于修复我们弄坏的部分，四条都只授予
# 只读的 search/getattr。实测加入后该域的拒绝数由一大串降为 0。
#
# 注：早先这里写着"内存扩展开关修不好是因为本机没有 /proc/nandswap 等内核接口"，
# 那已经是过时结论。oplus_mm_hybridswap_zram 现已开机自动加载，
# /product/bin/init.oplus.nandswap.sh 靠 /sys/block/zram0/hybridswap_core_enable
# 自行探测并接管全套启用逻辑，mem→zram→UFS 三层实测全通。
# 原文提到的 restore_ram_expansion_intent 函数也早已从 service.sh 删除。
# 下面四条规则与内核缺口无关，是纯粹的挂载副作用修复，保留。
# 后两条对应 post_boot 脚本的 bind——该 bind 已撤销，但 KernelSU 自身的
# 挂载仍可能让 nandswap 自检 getattr 到这两个路径，故一并留着，纯只读无风险。
allow nandswap adb_data_file dir search;
allow nandswap vendor_file file getattr;
allow nandswap vendor_qti_init_shell_exec file getattr;
allow nandswap unlabeled dir getattr;
