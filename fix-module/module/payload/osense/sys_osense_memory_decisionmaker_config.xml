            </rule>
        </scene>
		
        <scene id="1005" name="SCENE_RES_MEM_PSI_LEAK">
            </scene>
		
        <scene id="1006" name="SCENE_RES_MEM_PSI_THREADEXCEEDED">
            <rule index="1" tag="memory" skip="memory">
                <condition memory_scene="threadPSI" memory="1" />
                <policy name="clear" type="smart-force" level_scene="threadPSI" level="1" />
            </rule>
        </scene>
		
		<scene id="1007" name="SCENE_ACTIVITY_IDLE">
            <rule index="2" tag="memory" skip="memory">
                
                <condition freemem="2" memory_scene="idle" memory="2+" sys_pressure="high" />
                <policy name="clear" type="cached" level_scene="idle_policy_param" level="1" />
            </rule>

            <!-- Low-pressure idle must remain passive.  Kernel reclaim and
                 lmkd still handle genuine pressure without a wake-time
                 swap-in burst. -->
        </scene>
		
	    <scene id="1008" name="SCENE_MEM_RELEASED">
            <!-- Proactive whole-memory compaction competed with SurfaceFlinger
                 immediately after wake.  High-order allocations can still
                 invoke bounded direct compaction when actually required. -->
        </scene>
		
        <scene id="1009" name="SCENE_RES_MEM_PSI_MULTIWINDOW">
            <!-- Source-phone multi-window PSI cleanup is disabled. It killed
                 cache while this 8 GiB port was already handling ZRAM I/O. -->
        </scene>

        <scene id="1010" name="SCENE_RES_MEM_PSI_KSWAPD_HIGHLOAD">
            <!-- HMBIRD/HybridSwap high-load policy requires kernel interfaces
                 absent from Lenovo GKI. Standard reclaim remains active. -->
        </scene>
		
        <scene id="1009" name="SCENE_RES_MEM_PSI_MINIPROGRAM">
            <!-- Mini-program-specific proactive cleanup is not applicable to
                 this tablet workload and is intentionally passive. -->
        </scene>

    </config>

