# FrameTimeline-only variant for repeated A/B runs. Keeping ftrace out makes
# each capture small and avoids ftrace-buffer/session effects between samples.
buffers {
  size_kb: 8192
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
    target_buffer: 0
  }
}

duration_ms: 10000
