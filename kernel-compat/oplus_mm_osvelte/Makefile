# 一加 mm/mm_osvelte。与 sweep_oplus_modules.sh 用同一套 CONFIG 并集编译——
# osvelte 被 oplus_mm_hybridswap_zram 与 oplus_mm_uxmem_opt 依赖，各模块开的宏
# 不一致会让共享结构体布局对不上，所以这里必须逐字沿用，不能只开自己用得到的。
# 唯一的本地改动见 logger.c 顶部：procfs 根目录名固定为 osvelte。
obj-m += oplus_mm_mm_osvelte.o
oplus_mm_mm_osvelte-y := proc-memstat.o logger.o lowmem-dbg.o sys-memstat.o sys-dmabuf.o mm-config.o common.o sys-ashmem.o vsprintf-dup.o
ccflags-y += -I$(src) -include linux/sched/cputime.h -Wno-error -DCONFIG_ANDROID_BINDER_IPC_VIP_THREAD -DCONFIG_ASHMEM -DCONFIG_BLOCKIO_UX_OPT -DCONFIG_CRYPTO_LZ4K -DCONFIG_CRYPTO_ZSTDN -DCONFIG_DUMP_TASKS_MEM -DCONFIG_HYBRIDSWAP -DCONFIG_HYBRIDSWAP_CORE -DCONFIG_HYBRIDSWAP_SWAPD -DCONFIG_HYBRIDSWAP_ZRAM -DCONFIG_HYBRID_ZSMALLOC -DCONFIG_KCOMPRESSD -DCONFIG_KSHRINK_LRUVECD -DCONFIG_KSHRINK_SLABD -DCONFIG_MAPPED_PROTECT -DCONFIG_MEMLEAK_DETECT -DCONFIG_MEMLEAK_DETECT_SIMPLE -DCONFIG_OPLUS_BINDER_STRATEGY -DCONFIG_OPLUS_BINDER_TRANS_CTRL -DCONFIG_OPLUS_CPU_AUDIO_PERF -DCONFIG_OPLUS_CPU_FREQ_GOV_UAG -DCONFIG_OPLUS_CPUFREQ_IOWAIT_PROTECT -DCONFIG_OPLUS_EXIT_MM_OPTIMIZE -DCONFIG_OPLUS_FEATURE_ABNORMAL_FLAG -DCONFIG_OPLUS_FEATURE_ATD -DCONFIG_OPLUS_FEATURE_BINDER_STATS_ENABLE -DCONFIG_OPLUS_FEATURE_CPU_GAME -DCONFIG_OPLUS_FEATURE_CPU_JANKINFO -DCONFIG_OPLUS_FEATURE_DISPCAP -DCONFIG_OPLUS_FEATURE_DYNAMIC_READAHEAD -DCONFIG_OPLUS_FEATURE_EAS_OPT -DCONFIG_OPLUS_FEATURE_FRAME_BOOST -DCONFIG_OPLUS_FEATURE_GKI_CPUFREQ_BOUNCING -DCONFIG_OPLUS_FEATURE_LOADBALANCE -DCONFIG_OPLUS_FEATURE_MIDAS -DCONFIG_OPLUS_FEATURE_MIDAS_GKI -DCONFIG_OPLUS_FEATURE_MIDAS_V2 -DCONFIG_OPLUS_FEATURE_MM_OSVELTE -DCONFIG_OPLUS_FEATURE_MM_OSVELTE_DBG -DCONFIG_OPLUS_FEATURE_OCH -DCONFIG_OPLUS_FEATURE_PIPELINE -DCONFIG_OPLUS_FEATURE_POWER_DIAG -DCONFIG_OPLUS_FEATURE_QOS_SCHED -DCONFIG_OPLUS_FEATURE_SCHED_ASSIST -DCONFIG_OPLUS_FEATURE_SET_ALL_VPU_LATENCY -DCONFIG_OPLUS_FEATURE_SIGKILL_DIAGNOSIS -DCONFIG_OPLUS_FEATURE_SLC -DCONFIG_OPLUS_FEATURE_SUGOV_POWER_EFFIENCY -DCONFIG_OPLUS_FEATURE_TASK_CPUSTATS -DCONFIG_OPLUS_FEATURE_TASK_LOAD -DCONFIG_OPLUS_FEATURE_TASK_SCHED -DCONFIG_OPLUS_FEATURE_TOUCH_BOOST -DCONFIG_OPLUS_FEATURE_UXMEM_OPT -DCONFIG_OPLUS_FEATURE_VT_CAP -DCONFIG_OPLUS_FEATURE_WAKER_IDENTIFY -DCONFIG_OPLUS_LEVEL_PROTECT -DCONFIG_OPLUS_LOCKING_MONITOR -DCONFIG_OPLUS_LOCKING_PIFUTEX -DCONFIG_OPLUS_LOCKING_STRATEGY -DCONFIG_OPLUS_OMRG -DCONFIG_OPLUS_PERF_SCHEDINFO -DCONFIG_OPLUS_PROCS_LOAD_STATE -DCONF