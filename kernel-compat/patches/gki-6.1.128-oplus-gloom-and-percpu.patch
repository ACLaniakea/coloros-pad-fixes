@@ -1828,8 +1828,21 @@
 	info.high_limit = arch_get_mmap_base(addr, mm->mmap_base);
 	info.align_mask = 0;
 	info.align_offset = 0;
+
+	/* gloom：先问碎片池要一段，命中直接返回 */
+	addr = 0;
+	trace_android_vh_get_from_fragment_pool(mm, &info, &addr);
+	if (addr)
+		return addr;
+
+	/* gloom：把 VA 保留区排除在本次搜索之外 */
+	trace_android_vh_exclude_reserved_zone(mm, &info);
+
 	addr = vm_unmapped_area(&info);
 
+	/* gloom：上面失败时，允许把保留区纳入再试一次 */
+	trace_android_vh_include_reserved_zone(mm, &info, &addr);
+
 	/*
 	 * A failed mmap() very likely causes application failure,
 	 * so fall back to the bottom-up function here. This scenario
@@ -2192,6 +2205,8 @@
 
