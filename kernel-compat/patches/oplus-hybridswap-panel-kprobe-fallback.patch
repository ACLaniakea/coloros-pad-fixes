+		log_err("panel event kprobe registration failed: %d\n", ret);
+		return;
+	}
+	panel_event_kp_registered = true;
+	log_warn("panel event kprobe registered\n");
+#elif IS_ENABLED(CONFIG_DRM_PANEL_NOTIFY) || IS_ENABLED(CONFIG_QCOM_PANEL_EVENT_NOTIFIER)
