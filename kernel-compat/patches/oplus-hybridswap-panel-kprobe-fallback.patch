-#if IS_ENABLED(CONFIG_DRM_PANEL_NOTIFY) || IS_ENABLED(CONFIG_QCOM_PANEL_EVENT_NOTIFIER)
+#ifdef CONFIG_OPLUS_HYBRIDSWAP_PANEL_KPROBE_FALLBACK
+/* Lenovo's notifier rejects OPlus's MM client ID. On this 6.1 ABI, its
+ * dispatcher receives the primary-panel tag in x0 and a notification pointer
+ * in x1; notif_type 1 is blank and 2 is unblank.
+ */
+static int hybridswap_panel_event_pre_handler(struct kprobe *p,
+		struct pt_regs *regs)
+{
+	unsigned long tag = regs->regs[0];
+	struct panel_event_prefix *event = (void *)regs->regs[1];
+
+	if (tag == 1 && event && READ_ONCE(event->notif_type) == 1)
+		atomic_set(&display_off, 1);
+	else if (tag == 1 && event && READ_ONCE(event->notif_type) == 2)
+		atomic_set(&display_off, 0);
+	return 0;
+}
+#elif IS_ENABLED(CONFIG_DRM_PANEL_NOTIFY) || IS_ENABLED(CONFIG_QCOM_PANEL_EVENT_NOTIFIER)
 static struct drm_panel *get_active_panel(void)
 {
