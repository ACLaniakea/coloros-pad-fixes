<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="302001"
    android:versionName="3.2.1"
    android:compileSdkVersion="36"
    android:compileSdkVersionCodename="16"
    package="com.aclaniakea.lenovopenbridge"
    platformBuildVersionCode="36"
    platformBuildVersionName="16">
    <uses-sdk
        android:minSdkVersion="31"
        android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <uses-permission android:name="com.oplus.ipemanager.permission.receiver.DOUBLE_CLICK"/>
    <uses-permission android:name="com.oplus.permission.safe.IOT"/>
    <uses-permission android:name="com.oplus.permission.safe.SETTINGS"/>
    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:extractNativeLibs="true">
        <meta-data
            android:name="xposedmodule"
            android:value="true"/>
        <meta-data
            android:name="xposedminversion"
            android:value="93"/>
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description"/>
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope"/>
        <receiver
            android:name="com.aclaniakea.colorosporttuning.PenBridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="lenovo.intent.action.PEN_BT_CHANGED"/>
                <action android:name="com.zui.udevice.action.PEN_BT_CHANGED"/>
                <action android:name="lenovo.intent.action.PEN_BATTERY_CHANGED"/>
                <action android:name="com.zui.udevice.action.PEN_BATTERY_CHANGED"/>
                <action android:name="lenovo.intent.action.INPUT_DEVICE_STATE_CHANGED"/>
                <action android:name="lenovo.intent.action.INPUT_DEVICE_PEN_CLICK_TOUCH_SCREEN_START_CHANGED"/>
                <action android:name="lenovo.intent.action.INPUT_DEVICE_PEN_CLICK_OPEN_BLUETOOTH"/>
                <action android:name="lenovo.intent.action.INPUT_DEVICE_PEN_REMOUNT_CONTROL_CHANGED"/>
                <action android:name="lenovo.intent.action.PEN_VERSION"/>
                <action android:name="lenovo.intent.action.PEN_SN"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.USER_UNLOCKED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED"/>
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED"/>
                <action android:name="android.bluetooth.device.action.BOND_STATE_CHANGED"/>
                <action android:name="android.bluetooth.device.action.BATTERY_LEVEL_CHANGED"/>
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED"/>
                <action android:name="com.aclaniakea.lenovopenbridge.action.HAPTIC_TRANSPORT"/>
            </intent-filter>
        </receiver>
        <provider
            android:name="com.aclaniakea.colorosporttuning.PenStateProvider"
            android:authorities="com.aclaniakea.lenovopenbridge.penstate"
            android:exported="true"
            android:directBootAware="true"/>
    </application>
</manifest>
